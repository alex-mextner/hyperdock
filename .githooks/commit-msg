#!/bin/sh
# commit-msg: Conventional Commits subject (feat|fix|...: text), then the machine-wide hooks.
msg_file=$1
subject=$(sed -n '1p' "$msg_file")

case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *) ;;
*)
	if ! printf '%s\n' "$subject" | grep -q -E '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*'; then
		echo "commit-msg: subject must be a Conventional Commit, e.g. 'fix(dock): keep icons inside the shelf'" >&2
		echo "commit-msg: types: feat fix docs style refactor perf test build ci chore revert" >&2
		echo "commit-msg: got: $subject" >&2
		exit 1
	fi
	;;
esac

exec "$(dirname "$0")/chain-global" commit-msg "$@"

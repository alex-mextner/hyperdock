{
  // Second linter next to ESLint (`make lint`): oxlint's `correctness` category, a different
  // rule engine that catches other bug classes (no-debugger, const-comparisons, use-isnan,
  // no-self-assign, ...). The anti-slop plugin from agent-tools is TypeScript-only (type
  // assertions, unknown-typed params), so it has no plain-JS rules to run on a GJS extension.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "plugins": ["oxc", "unicorn", "typescript"],
  "ignorePatterns": ["build/**", "node_modules/**", "ci/**", "tests/**", "tools/**", "screenshots/**"],
  "rules": {
    // Owned by ESLint, where it is a warning with the repo's `_`-prefix convention.
    "no-unused-vars": "off",
    // extension.js opens with a `'use strict'` directive expression.
    "no-unused-expressions": "off",
    // Spreading `get_children()` snapshots the list so it can be iterated while it is mutated.
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  }
}
